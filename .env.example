# AI Proxy Server Environment Variables
# For Google Gemini (Free tier available at https://aistudio.google.com):
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent
AI_KEY=your_gemini_api_key_here

# Proxy port (backend runs on 4000, frontend runs on 3000)
PORT=4000
